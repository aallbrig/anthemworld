{
  "uid": "anthem-product-engagement",
  "title": "Anthem World — Product Engagement",
  "tags": ["anthemworld", "product", "engagement"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Engagement funnel", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1 },
    {
      "type": "stat",
      "title": "Sessions created (range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [ { "refId": "A", "expr": "sum(increase(anthem_sessions_created[$__range]))", "legendFormat": "sessions" } ]
    },
    {
      "type": "stat",
      "title": "Matchups served (range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "targets": [ { "refId": "A", "expr": "sum(increase(anthem_matchups_served[$__range]))", "legendFormat": "matchups" } ]
    },
    {
      "type": "stat",
      "title": "Votes cast (range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [ { "refId": "A", "expr": "sum(increase(anthem_votes[$__range]))", "legendFormat": "votes" } ]
    },
    {
      "type": "stat",
      "title": "Votes per matchup (conversion)",
      "description": "Higher means users vote on more of the matchups they're served.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(increase(anthem_votes[$__range])) / clamp_min(sum(increase(anthem_matchups_served[$__range])), 1)", "legendFormat": "votes/matchup" } ]
    },

    { "type": "row", "title": "Activity over time", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "id": 6 },
    {
      "type": "timeseries",
      "title": "Sessions / Matchups / Votes per minute",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "id": 7,
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(anthem_sessions_created[$__rate_interval])) * 60", "legendFormat": "sessions/min" },
        { "refId": "B", "expr": "sum(rate(anthem_matchups_served[$__rate_interval])) * 60", "legendFormat": "matchups/min" },
        { "refId": "C", "expr": "sum(rate(anthem_votes[$__rate_interval])) * 60", "legendFormat": "votes/min" }
      ]
    },
    {
      "type": "piechart",
      "title": "Votes by weight category",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 8,
      "targets": [
        { "refId": "A", "expr": "sum by (vote_category) (increase(anthem_votes[$__range]))", "legendFormat": "{{vote_category}}" }
      ]
    },

    { "type": "row", "title": "By country", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "id": 9 },
    {
      "type": "bargauge",
      "title": "Top 10 anthems by wins",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "id": 10,
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-GrYlRd" } } },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (country_id) (anthem_country_votes{result=\"win\"}))", "legendFormat": "{{country_id}}", "instant": true }
      ]
    },
    {
      "type": "bargauge",
      "title": "Top 10 anthems by losses",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "id": 11,
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-BlPu" } } },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (country_id) (anthem_country_votes{result=\"loss\"}))", "legendFormat": "{{country_id}}", "instant": true }
      ]
    },

    { "type": "row", "title": "Listening behavior", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "id": 12 },
    {
      "type": "timeseries",
      "title": "Top 5 most-listened anthems (events/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 13,
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "topk(5, sum by (country_id) (rate(anthem_listen_events[$__rate_interval]))) * 60", "legendFormat": "{{country_id}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Listen time per event p50 / p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 14,
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(anthem_listen_ms_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(anthem_listen_ms_bucket[$__rate_interval])))", "legendFormat": "p95" }
      ]
    }
  ]
}
