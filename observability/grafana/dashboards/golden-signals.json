{
  "uid": "anthem-golden-signals",
  "title": "Anthem World — SRE Golden Signals",
  "tags": ["anthemworld", "sre", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_requests, route)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Traffic", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1 },
    {
      "type": "timeseries",
      "title": "Request rate by route (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(http_server_requests{route=~\"$route\"}[$__rate_interval]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Total throughput (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" } } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests[$__rate_interval]))", "legendFormat": "req/s" }
      ]
    },

    { "type": "row", "title": "Errors", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 4 },
    {
      "type": "timeseries",
      "title": "Error ratio (% of requests, 5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(http_server_requests{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests[$__rate_interval])), 0.001)", "legendFormat": "5xx %" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors by route and class (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route, status_class) (rate(http_server_requests{status_class=~\"4xx|5xx\"}[$__rate_interval]))", "legendFormat": "{{route}} {{status_class}}" }
      ]
    },

    { "type": "row", "title": "Latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "id": 7 },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 19 },
      "id": 8,
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_bucket{route=~\"$route\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_bucket{route=~\"$route\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_bucket{route=~\"$route\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_duration_bucket[$__rate_interval])))", "legendFormat": "{{route}}" }
      ]
    },

    { "type": "row", "title": "Saturation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "id": 10 },
    {
      "type": "timeseries",
      "title": "Estimated in-flight concurrency (Little's law)",
      "description": "sum(rate(duration_sum))/1000 ≈ average concurrent requests. In prod this maps to Lambda concurrency limits.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 11,
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_duration_sum[$__rate_interval])) / 1000", "legendFormat": "avg concurrency" }
      ]
    },
    {
      "type": "gauge",
      "title": "p99 latency vs 10s Lambda timeout",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 12,
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "max": 10000, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 3000 }, { "color": "red", "value": 5000 } ] } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    }
  ]
}
