# SAM Game Backend — Environment Variables
# Copy to env.local.json (per-function overrides) or set in your shell.
# See template.yaml Globals.Function.Environment for defaults.

# --- DynamoDB Table Names (auto-set by SAM via !Ref) ---
RANKINGS_TABLE=anthem-rankings-local
VOTES_TABLE=anthem-votes-local
SESSIONS_TABLE=anthem-sessions-local
LISTEN_TABLE=anthem-listen-history-local

# --- LocalStack (local development only) ---
LOCAL_DYNAMODB_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Rate Limiting ---
MAX_SESSIONS_PER_IP=5         # Sessions allowed per IP per calendar day
MAX_VOTES_PER_SESSION=100     # Votes allowed per session per calendar day
MAX_MATCHUPS_PER_SESSION=300  # Matchups allowed per session per calendar day

# --- Security ---
MIN_LISTEN_MS=3000            # Minimum listen time (ms) before a vote is accepted
CORS_ORIGIN=*                 # Set to your domain in production (e.g. https://anthemworld.com)

# --- Stage ---
STAGE=local                   # local | dev | prod
